{
  "name": "social-reader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal reader for the useful parts of your social feeds.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "aurora": "cli/aurora.ts"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "dev": "node --watch server/main.ts & vite --config web/vite.config.ts",
    "dev:server": "node --watch server/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "prestart": "node scripts/check-node.mjs",
    "start": "node server/main.ts",
    "pretest": "node scripts/check-node.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mcp": "node server/mcp.ts",
    "perf": "node scripts/perf.ts",
    "tui": "node cli/aurora.ts",
    "a11y": "node scripts/a11y.mjs",
    "smoke": "node scripts/smoke.mjs",
    "showcase": "node scripts/showcase.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "^0.6.0",
    "fast-xml-parser": "^5.11.2",
    "hls.js": "^1.7.3",
    "linkedom": "^0.18.13",
    "playwright-core": "1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "typescript": "^7.0.2",
    "vite": "^6.4.4"
  }
}
