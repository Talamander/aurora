post_install() {
  cat <<'MSG'
==> Aurora is installed. Start it for your user (it listens on 127.0.0.1:4317 only):
      systemctl --user enable --now aurora
    Then open "Aurora" from your launcher, or http://127.0.0.1:4317.
    Your data lives in ~/.local/share/aurora. Back up secret.key and local.key with it.
    Omarchy extras to copy yourself: /usr/share/aurora/omarchy (Waybar module, Hyprland bindings).
MSG
}

post_upgrade() {
  cat <<'MSG'
==> Restart Aurora to use the new version:
      systemctl --user restart aurora
MSG
}
