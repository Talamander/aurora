# Copy to .env next to docker-compose.yml. Every line is optional.

# Host port (always bound to 127.0.0.1).
SR_PORT=4317

# Extra host names the app answers to, comma separated (for example your Tailscale name,
# reader.tailnet-name.ts.net). Only add names that sit behind authentication.
SR_EXTRA_HOSTS=

# Background sync interval for free feeds, in minutes. 0 turns it off.
AUTO_SYNC_MINUTES=30

# AI provider. Leave empty and set it in the app instead, or use a local model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Actor sandbox: auto (bubblewrap when possible) or none.
SR_ACTOR_ISOLATION=auto
